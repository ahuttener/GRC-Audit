# GRC Audit — hardening for the /grcaudit folder (Apache / LiteSpeed, e.g. Hostinger)

# No directory listings
Options -Indexes

# Never expose version-control metadata (e.g. from a Git deployment)
RedirectMatch 404 /\.(git|github)(/|$)

# Config files must never be served (the key normally lives outside public_html anyway)
<FilesMatch "^(config|grcaudit-config)(\.sample)?\.php$">
  Require all denied
</FilesMatch>

# Shared PHP libraries (e.g. api/_metrics-lib.php) are included, never requested directly
<FilesMatch "^_.*\.php$">
  Require all denied
</FilesMatch>

# Metrics database, API caches and rate-limit counters (they normally live outside public_html)
<FilesMatch "\.(sqlite|sqlite-journal|cnt)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /grcaudit-data(/|$)

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Pages must be revalidated on every visit: a cached page from an older deploy points at
  # script files that no longer exist, and Next.js then fails with "client-side exception".
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Scripts and styles carry a content hash in their name, so they can be cached for good.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

ErrorDocument 404 /grcaudit/404.html
